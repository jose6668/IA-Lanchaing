# Copia este archivo a .env; no añadas claves reales al repositorio.
# Las variables del proceso tienen prioridad sobre .env.
APP_ENV=development
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MODEL_TEMPERATURE=0.3
MODEL_TIMEOUT_SECONDS=60
MODEL_MAX_RETRIES=2
MODEL_MAX_TOKENS=1500
MAX_HISTORY_MESSAGES=20

# Vacío mantiene conversation_memory.sqlite en desarrollo.
# En producción: ruta ABSOLUTA dentro del disco/volumen persistente.
MEMORY_DB_PATH=
